# Copié en /srv/portfolio/.env sur le serveur, jamais versionné.

# Clé Anthropic de la démo IA. Sans elle, le simulateur hors ligne répond.
ANTHROPIC_API_KEY=
# Modèle appelé (facultatif). Un modèle plus léger coûte moins cher par analyse.
# LLM_MODEL=claude-sonnet-5-5

# Plafonds de la démo IA : analyses par visiteur et par heure, et pour tout le monde par jour.
LLM_QUOTA_VISITEUR=5
LLM_QUOTA_JOUR=100
